{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "diva-live-helper",
  "version": "0.1.0",
  "identifier": "moe.lyt.diva-live-helper",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DIVA直播助手",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"],
    "resources": [
      "../Data/song_db.json",
      "../Data/song_name_zh.json",
      "../Data/AnotherSongName.json",
      "../Data/HanziKanjiDict.txt"
    ]
  }
}
